[Unit]
Description=Society Lab experiment API
After=network-online.target
Wants=network-online.target

[Service]
User=society-lab
Group=society-lab
WorkingDirectory=/opt/society-lab
Environment=SOCIETY_LAB_READ_ONLY=0
Environment=SOCIETY_LAB_INCLUDE_ARCHIVE=1
Environment=SOCIETY_LAB_ENV_FILE=/var/lib/society-lab/.env
Environment=SOCIETY_LAB_RUNS_DIR=/var/lib/society-lab/runs
Environment=HOME=/var/lib/society-lab
StateDirectory=society-lab
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/society-lab/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8012 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
