[Unit]
Description=Society Lab public showcase API
After=network-online.target
Wants=network-online.target

[Service]
User=society-lab
Group=society-lab
WorkingDirectory=/opt/society-lab
Environment=SOCIETY_LAB_READ_ONLY=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/society-lab/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8012 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
